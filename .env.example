# Copy to .env (gitignored). Nothing here is required for the base package.

# Stable tokens for guarded_scan and deidentify(method="token"); any long
# random string. Keep it: changing it changes every token.
ARCHE_HASH_KEY=change-me-to-a-long-random-string

# Where arche serve, arche mcp and the CLI keep decisions.
ARCHE_LEDGER=duckdb:///arche.duckdb

# Only for examples/mcp_chat.py and the arche.llm harness.
OPENAI_API_KEY=sk-your-openai-key
